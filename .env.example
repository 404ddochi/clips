APP_NAME=CLIPS
APP_ENV=local
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8001
# Local override. Unset → default SITE_URL is https://playclips.kr
# Production: SITE_URL must be https://your-domain (never localhost)
SITE_URL=http://127.0.0.1:8001
APP_BASE_URL=http://127.0.0.1:8001
SECRET_KEY=change-me
DATABASE_URL=sqlite:///./clips.db
DEFAULT_LOCALE=ko
TIMEZONE=Asia/Seoul
