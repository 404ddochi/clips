# CLIPS monitor / Discord webhook settings (ops only — do not commit real values).
# Install as /etc/clips-monitor.env with owner root:root and mode 600.

DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=CLIPS Monitor
DISCORD_TIMEOUT_SECONDS=5
HOST_LABEL=production
MONITOR_STATE_DIR=/var/lib/clips-monitor
ALERT_COOLDOWN_SECONDS=3600

# Optional overrides used by check scripts:
# SERVICE_NAME=clips
# HEALTH_URL=http://127.0.0.1:8000/health
# BACKUP_DIR=/backup/clips
# MIN_SIZE_BYTES=500
# BACKUP_LOG_FILE=/var/log/clips-backup.log
